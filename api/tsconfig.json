{
  // Function-only compiler settings (H-06, D-042). Vercel's @vercel/node looks up the tsconfig
  // nearest the entry (api/index.ts) and compiles the function with it. The root tsconfig is
  // for Vite and vitest (ESM, bundler resolution) and must not change the function's output format.
  // Do not pass --noEmit to this file in a build step: @vercel/node needs the emitted JS.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node10",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["index.ts"]
}
