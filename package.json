{
  "name": "mlb-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "MLB Free Agent Tracker",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx src/server/index.ts",
    "build": "vite build",
    "postinstall": "prisma generate",
    "start": "tsx src/server/index.ts",
    "sync": "tsx src/jobs/runSync.ts",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:check": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"${TEST_DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54330/mlb_tracker_test}\" --exit-code",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait db"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "express": "^4.21.0",
    "fflate": "^0.8.3",
    "js-yaml": "^4.1.0",
    "prisma": "^6.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2",
    "vite": "^5.4.2",
    "vitest": "^2.1.0"
  }
}
