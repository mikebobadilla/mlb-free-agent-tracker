# Local Postgres from docker-compose (`npm run db:up`, port 54330; D-034).
# On Supabase, DATABASE_URL is the transaction pooler (port 6543) with
# ?pgbouncer=true&connection_limit=1 and DIRECT_URL is the session pooler or the
# direct connection (port 5432).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54330/mlb_tracker"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54330/mlb_tracker"
# Tests only: each test file gets a throwaway schema in this database and drops it afterwards (D-022).
# vitest does not read .env; export TEST_DATABASE_URL in your shell to override the default shown here.
TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54330/mlb_tracker_test"
# CRON_SECRET=   # Bearer token for GET /api/cron/sync (D-036); set a real value only in Vercel/.env, never commit it
